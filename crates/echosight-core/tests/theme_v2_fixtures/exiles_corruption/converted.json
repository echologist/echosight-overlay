{
  "theme": {
    "format": 2,
    "id": "exiles_corruption",
    "name": "Exile's Corruption",
    "tokens": {
      "colors": {
        "primary": "#8b0000",
        "secondary": "#dc143c",
        "accent": "#4b0082",
        "danger": "#ff1744",
        "text": {
          "primary": "#e6e6fa",
          "secondary": "#dda0dd",
          "muted": "#9370db",
          "inverse": "#000000"
        },
        "surface": {
          "primary": "rgba(25, 0, 25, 0.9)",
          "secondary": "rgba(35, 0, 35, 0.8)",
          "tertiary": "rgba(45, 0, 45, 0.6)",
          "transparent": "transparent"
        },
        "border": {
          "primary": "#8b0000",
          "secondary": "#4b0082",
          "interactive": "#dc143c"
        }
      },
      "opacity": {
        "appliesTo": [
          "surface.primary",
          "surface.secondary",
          "surface.tertiary"
        ]
      },
      "fonts": {
        "ui": {
          "family": [
            "Segoe UI",
            "Tahoma",
            "Geneva",
            "Verdana",
            "sans-serif"
          ]
        },
        "sizes": {
          "header": 16.0,
          "task": 13.0,
          "progress": 12.0,
          "ui": 12.0
        },
        "weights": {
          "normal": 400.0,
          "bold": 600.0
        }
      },
      "shadows": {
        "text": [
          {
            "x": 0.0,
            "y": 0.0,
            "blur": 4.0,
            "spread": 0.0,
            "color": "rgba(220, 20, 60, 0.8)"
          },
          {
            "x": 0.0,
            "y": 1.0,
            "blur": 2.0,
            "spread": 0.0,
            "color": "rgba(0, 0, 0, 0.9)"
          }
        ]
      },
      "radius": {
        "default": 6.0
      }
    },
    "slots": {
      "taskText": {
        "text": {
          "color": "@text.primary",
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.task",
          "weight": "@fonts.weights.normal",
          "shadow": "@shadows.text"
        },
        "states": {
          "completed": {
            "text": {
              "color": "@text.muted"
            }
          }
        }
      },
      "progressText": {
        "text": {
          "color": "@text.secondary",
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.progress",
          "weight": "@fonts.weights.bold",
          "shadow": "@shadows.text"
        }
      },
      "window.interactive": {
        "text": {
          "family": "@fonts.ui.family"
        },
        "fill": {
          "gradient": {
            "angle": 135.0,
            "stops": [
              [
                "@colors.surface.primary",
                0.0
              ],
              [
                "rgba(35, 0, 35, 0.95)",
                0.5
              ],
              [
                "@colors.surface.primary",
                1.0
              ]
            ]
          }
        },
        "opacityAffects": true,
        "border": {
          "width": 2.0,
          "style": "solid",
          "color": "@colors.border.interactive"
        }
      },
      "window.clickThrough": {
        "text": {
          "family": "@fonts.ui.family"
        },
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(139, 0, 0, 0.4)"
        },
        "shadow": [
          {
            "x": 0.0,
            "y": 0.0,
            "blur": 15.0,
            "spread": 0.0,
            "color": "rgba(220, 20, 60, 0.2)"
          }
        ]
      },
      "button": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui",
          "shadow": "@shadows.text"
        },
        "radius": "@radius.default"
      },
      "input": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui"
        },
        "radius": "@radius.default"
      },
      "select": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui"
        },
        "radius": "@radius.default"
      },
      "headerTitle": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.header"
        }
      },
      "button.primary": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text"
        }
      },
      "button.danger": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text"
        }
      },
      "button.icon": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text"
        }
      },
      "dialog.button.primary": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text",
          "color": "#ffe6ef"
        },
        "fill": {
          "gradient": {
            "angle": 180.0,
            "stops": [
              [
                "rgba(139,0,0,0.86)",
                0.0
              ],
              [
                "rgba(75,0,130,0.86)",
                1.0
              ]
            ]
          }
        },
        "opacityAffects": false,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(220,20,60,0.75)"
        },
        "states": {
          "hover": {
            "shadow": [
              {
                "x": 0.0,
                "y": 0.0,
                "blur": 14.0,
                "spread": 0.0,
                "color": "rgba(220,20,60,0.45)"
              }
            ]
          }
        }
      },
      "dialog.button.secondary": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text",
          "color": "#dda0dd"
        },
        "fill": "rgba(35,0,35,0.82)",
        "opacityAffects": false,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(75,0,130,0.8)"
        },
        "states": {
          "hover": {
            "shadow": [
              {
                "x": 0.0,
                "y": 0.0,
                "blur": 14.0,
                "spread": 0.0,
                "color": "rgba(220,20,60,0.45)"
              }
            ]
          }
        }
      },
      "textarea": {
        "radius": "@radius.default"
      },
      "progressBar": {
        "radius": "@radius.default"
      },
      "header": {
        "fill": {
          "gradient": {
            "angle": 135.0,
            "stops": [
              [
                "rgba(139, 0, 0, 0.8)",
                0.0
              ],
              [
                "rgba(75, 0, 130, 0.6)",
                1.0
              ]
            ]
          }
        },
        "opacityAffects": false,
        "shadow": [
          {
            "x": 0.0,
            "y": 2.0,
            "blur": 10.0,
            "spread": 0.0,
            "color": "rgba(220, 20, 60, 0.3)"
          }
        ]
      },
      "templateSection": {
        "fill": {
          "gradient": {
            "angle": 180.0,
            "stops": [
              [
                "@colors.surface.secondary",
                0.0
              ],
              [
                "@colors.surface.tertiary",
                1.0
              ]
            ]
          }
        },
        "opacityAffects": true
      },
      "tasksSection": {
        "fill": {
          "gradient": {
            "angle": 180.0,
            "stops": [
              [
                "@colors.surface.tertiary",
                0.0
              ],
              [
                "@colors.surface.secondary",
                1.0
              ]
            ]
          }
        },
        "opacityAffects": true
      },
      "dialog.scrim": {
        "fill": "rgba(10,0,12,0.82)",
        "opacityAffects": false
      },
      "dialog.window": {
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(220,20,60,0.72)"
        },
        "radius": 6.0,
        "text": {
          "color": "#e6e6fa"
        }
      },
      "dialog.title": {
        "text": {
          "color": "#ff6b86",
          "shadow": [
            {
              "x": 0.0,
              "y": 0.0,
              "blur": 10.0,
              "spread": 0.0,
              "color": "rgba(220,20,60,0.7)"
            }
          ]
        }
      },
      "dialog.text": {
        "text": {
          "color": "#f0e6ff"
        }
      },
      "dialog.hint": {
        "text": {
          "color": "#dda0dd"
        }
      },
      "communityTemplateCard": {
        "fill": "rgba(25,0,25,0.58)",
        "opacityAffects": false,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(139,0,0,0.42)"
        }
      },
      "dialog.danger.title": {
        "text": {
          "color": "#ff8ba0"
        }
      }
    },
    "images": {},
    "version": "1.0.1",
    "author": "Echosight",
    "description": "Dark corruption theme inspired by PoE's corruption mechanics with deep purples and red accents",
    "supportsTransparency": false
  },
