          "size": "@fonts.sizes.progress",
          "weight": "@fonts.weights.bold",
          "shadow": "@shadows.text"
        }
      },
      "window.interactive": {
        "text": {
          "family": [
            "system-ui",
            "sans-serif"
          ]
