{
  "theme": {
    "format": 2,
    "id": "cs16",
    "name": "CS 1.6",
    "tokens": {
      "colors": {
        "primary": "#c4b550",
        "secondary": "#958831",
        "accent": "#c4b550",
        "danger": "#a0aa95",
        "text": {
          "primary": "#dedfd6",
          "secondary": "#d8ded3",
          "muted": "#a0aa95",
          "inverse": "#292c21",
          "disabled": "#292c21"
