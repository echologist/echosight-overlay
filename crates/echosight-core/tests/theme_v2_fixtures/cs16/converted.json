        "bevelOutset": [
          {
            "x": 1.0,
            "y": 1.0,
            "blur": 0.0,
            "spread": 0.0,
            "color": "@colors.border.light"
          },
          {
            "x": -1.0,
            "y": -1.0,
            "blur": 0.0,
            "spread": 0.0,
            "color": "@colors.border.dark"
          }
