{
  "theme": {
    "format": 2,
    "id": "minimal",
    "name": "Minimal",
    "tokens": {
      "colors": {
        "primary": "#ffffff",
        "secondary": "#32cd32",
        "accent": "#4169e1",
        "danger": "#dc143c",
        "text": {
          "primary": "#ffffff",
          "secondary": "#cccccc",
          "muted": "#aaaaaa",
          "inverse": "#000000"
        },
        "surface": {
          "primary": "transparent",
          "secondary": "transparent",
          "tertiary": "transparent",
          "transparent": "transparent"
        },
        "border": {
          "primary": "#ffffff",
          "secondary": "#ffffff",
          "interactive": "#ffffff"
        }
      },
      "opacity": {
        "appliesTo": []
      },
      "fonts": {
        "ui": {
          "family": [
            "Segoe UI",
            "Tahoma",
            "Geneva",
            "Verdana",
            "sans-serif"
          ]
        },
        "sizes": {
          "header": 16.0,
          "task": 13.0,
          "progress": 12.0,
          "ui": 12.0
        },
        "weights": {
          "normal": 700.0,
          "bold": 900.0
        }
      },
      "shadows": {
        "text": [],
        "window": []
      }
    },
    "slots": {
      "taskText": {
        "text": {
          "color": "@text.primary",
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.task",
          "weight": "@fonts.weights.normal",
          "shadow": "@shadows.text"
        },
        "states": {
          "completed": {
            "text": {
              "color": "@text.muted"
            }
          }
        }
      },
      "progressText": {
        "text": {
          "color": "@text.secondary",
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.progress",
          "weight": "@fonts.weights.bold",
          "shadow": "@shadows.text"
        }
      },
      "window.interactive": {
        "text": {
          "family": "@fonts.ui.family"
        },
        "border": {
          "width": 0,
          "style": "none"
        },
        "radius": 0.0,
        "shadow": []
      },
      "window.clickThrough": {
        "text": {
          "family": "@fonts.ui.family"
        },
        "border": {
          "width": 0,
          "style": "none"
        },
        "radius": 0.0,
        "shadow": []
      },
      "button": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui",
          "shadow": "@shadows.text"
        }
      },
      "input": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui"
        }
      },
      "select": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui"
        }
      },
      "headerTitle": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.header"
        }
      },
      "progressBar": {
        "shadow": "@shadows.window"
      },
      "header": {
        "shadow": []
      },
      "templateSection": {
        "shadow": []
      },
      "tasksSection": {},
      "dialog.scrim": {
        "fill": "rgba(0,0,0,0.42)"
      },
      "dialog.window": {
        "fill": "rgba(0,0,0,0.9)",
        "border": {
          "width": 2.0,
          "style": "solid",
          "color": "#fff"
        },
        "radius": 0.0,
        "shadow": [],
        "text": {
          "color": "#fff"
        }
      },
      "dialog.title": {
        "text": {
          "color": "#fff",
          "transform": "uppercase",
          "letterSpacing": 0.0
        }
      },
      "dialog.text": {
        "text": {
          "color": "#fff"
        }
      },
      "dialog.hint": {
        "text": {
          "color": "#d6d6d6"
        }
      },
      "communityTemplateCard": {
        "fill": "transparent",
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "#fff"
        }
      },
      "dialog.button.primary": {
        "fill": "#fff",
        "border": {
          "width": 2.0,
          "style": "solid",
          "color": "#fff"
        },
        "text": {
          "color": "#000"
        },
        "states": {
          "hover": {
            "ring": {
              "width": 2.0,
              "style": "solid",
              "color": "#fff",
              "inset": -2.0
            }
          }
        }
      },
      "dialog.button.secondary": {
        "fill": "transparent",
        "border": {
          "width": 2.0,
          "style": "solid",
          "color": "#fff"
        },
        "text": {
          "color": "#fff"
        },
        "states": {
          "hover": {
            "ring": {
              "width": 2.0,
              "style": "solid",
              "color": "#fff",
              "inset": -2.0
            }
          }
        }
      },
      "dialog.danger.title": {
        "text": {
          "color": "#ff6b6b"
        }
      }
    },
    "images": {},
    "version": "1.0.1",
    "author": "Echoesight",
    "description": "Clean minimal theme with no background",
    "supportsTransparency": true
  },
