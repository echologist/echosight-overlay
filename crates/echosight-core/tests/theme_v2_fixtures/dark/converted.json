      "message": "v1 field is not interpreted by the v2 converter",
      "value": false
    },
    {
      "severity": "warning",
      "location": "/styles/clickThrough/container/backdropFilter",
      "code": "unsupported-property",
      "message": "CSS declaration not representable by this bounded converter",
      "value": {
        "backdropFilter": "brightness(0.8)"
      }
    },
    {
      "severity": "warning",
      "location": "/styles/clickThrough/container/webkitBackdropFilter",
      "code": "unsupported-property",
      "message": "CSS declaration not representable by this bounded converter",
      "value": {
        "webkitBackdropFilter": "brightness(0.8)"
      }
    },
    {
      "severity": "warning",
      "location": "/styles/clickThrough/tasksSection",
      "code": "unsupported-mode-slot",
      "message": "no mode-qualified section slot in v2; manual application decision required",
      "value": {
        "background": "transparent"
      }
    },
    {
      "severity": "warning",
      "location": "/styles/interactive/header/borderBottom",
      "code": "unsupported-property",
      "message": "CSS declaration not representable by this bounded converter",
      "value": {
        "borderBottom": "1px solid var(--border-primary)"
      }
    },
    {
      "severity": "warning",
      "location": "/styles/interactive/templateSection/borderBottom",
      "code": "unsupported-property",
      "message": "CSS declaration not representable by this bounded converter",
      "value": {
        "borderBottom": "1px solid var(--border-secondary)"
      }
    },
    {
      "severity": "warning",
      "location": "/transparency",
      "code": "unmapped-field",
      "message": "v1 field is not interpreted by the v2 converter",
      "value": {
        "clickThrough": "var(--user-transparency, 0.25)",
        "interactive": "var(--user-transparency, 0.25)"
      }
    }
  ],
  "provisional": false
}
