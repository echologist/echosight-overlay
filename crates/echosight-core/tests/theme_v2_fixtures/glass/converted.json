{
  "theme": {
    "format": 2,
    "id": "glass",
    "name": "Glass",
    "tokens": {
      "colors": {
        "primary": "#d4af37",
        "secondary": "#32cd32",
        "accent": "#4169e1",
        "danger": "#dc143c",
        "text": {
          "primary": "#ffffff",
          "secondary": "#cccccc",
          "muted": "#aaaaaa",
          "inverse": "#000000"
        },
        "surface": {
          "primary": "rgba(255, 255, 255, 0.3)",
          "secondary": "rgba(255, 255, 255, 0.3)",
          "tertiary": "rgba(255, 255, 255, 0.3)",
          "transparent": "transparent"
        },
        "border": {
          "primary": "rgba(255, 255, 255, 0.3)",
          "secondary": "rgba(255, 255, 255, 0.2)",
          "interactive": "rgba(50, 205, 50, 0.6)"
        }
      },
      "opacity": {
        "appliesTo": [
          "surface.primary",
          "surface.secondary",
          "surface.tertiary"
        ]
      },
      "fonts": {
        "ui": {
          "family": [
            "Segoe UI",
            "Tahoma",
            "Geneva",
            "Verdana",
            "sans-serif"
          ]
        },
        "sizes": {
          "header": 16.0,
          "task": 13.0,
          "progress": 12.0,
          "ui": 12.0
        },
        "weights": {
          "normal": 400.0,
          "bold": 600.0
        }
      },
      "shadows": {
        "text": [
          {
            "x": 0.0,
            "y": 1.0,
            "blur": 2.0,
            "spread": 0.0,
            "color": "rgba(0, 0, 0, 0.5)"
          }
        ]
      },
      "radius": {
        "default": 12.0
      }
    },
    "slots": {
      "taskText": {
        "text": {
          "color": "@text.primary",
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.task",
          "weight": "@fonts.weights.normal",
          "shadow": "@shadows.text"
        },
        "states": {
          "completed": {
            "text": {
              "color": "@text.muted"
            }
          }
        }
      },
      "progressText": {
        "text": {
          "color": "@text.secondary",
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.progress",
          "weight": "@fonts.weights.bold",
          "shadow": "@shadows.text"
        }
      },
      "window.interactive": {
        "text": {
          "family": "@fonts.ui.family"
        },
        "fill": "@colors.surface.primary",
        "opacityAffects": true,
        "border": {
          "width": 2.0,
          "style": "solid",
          "color": "@colors.border.interactive"
        }
      },
      "window.clickThrough": {
        "text": {
          "family": "@fonts.ui.family"
        },
        "fill": "@colors.surface.primary",
        "opacityAffects": true,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "@colors.border.primary"
        }
      },
      "button": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui",
          "shadow": "@shadows.text"
        },
        "radius": "@radius.default"
      },
      "input": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui"
        },
        "radius": "@radius.default"
      },
      "select": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.ui"
        },
        "radius": "@radius.default"
      },
      "headerTitle": {
        "text": {
          "family": "@fonts.ui.family",
          "size": "@fonts.sizes.header"
        }
      },
      "button.primary": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text"
        }
      },
      "button.danger": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text"
        }
      },
      "button.icon": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text"
        }
      },
      "dialog.button.primary": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text",
          "color": "#fff"
        },
        "fill": "rgba(65,105,225,0.78)",
        "opacityAffects": false,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(255,255,255,0.42)"
        },
        "states": {
          "hover": {
            "shadow": [
              {
                "x": 0.0,
                "y": 0.0,
                "blur": 0.0,
                "spread": 2.0,
                "color": "rgba(255,255,255,0.18)"
              }
            ]
          }
        }
      },
      "dialog.button.secondary": {
        "radius": "@radius.default",
        "text": {
          "shadow": "@shadows.text",
          "color": "#fff"
        },
        "fill": "rgba(255,255,255,0.12)",
        "opacityAffects": false,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(255,255,255,0.28)"
        },
        "states": {
          "hover": {
            "shadow": [
              {
                "x": 0.0,
                "y": 0.0,
                "blur": 0.0,
                "spread": 2.0,
                "color": "rgba(255,255,255,0.18)"
              }
            ]
          }
        }
      },
      "textarea": {
        "radius": "@radius.default"
      },
      "progressBar": {
        "radius": "@radius.default"
      },
      "header": {
        "fill": "rgba(255, 255, 255, 0.1)",
        "opacityAffects": false
      },
      "templateSection": {
        "fill": "@colors.surface.secondary",
        "opacityAffects": true
      },
      "tasksSection": {
        "fill": "@colors.surface.tertiary",
        "opacityAffects": true,
        "radius": 8.0,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "@colors.border.secondary"
        }
      },
      "dialog.scrim": {
        "fill": "rgba(0,0,0,0.42)",
        "opacityAffects": false
      },
      "dialog.window": {
        "fill": {
          "gradient": {
            "angle": 180.0,
            "stops": [
              [
                "rgba(255,255,255,0.20)",
                0.0
              ],
              [
                "rgba(255,255,255,0.08)",
                1.0
              ]
            ]
          }
        },
        "opacityAffects": false,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(255,255,255,0.42)"
        },
        "radius": 12.0,
        "text": {
          "color": "#fff"
        }
      },
      "dialog.title": {
        "text": {
          "color": "#f6f6ff"
        }
      },
      "dialog.text": {
        "text": {
          "color": "#fff"
        }
      },
      "dialog.hint": {
        "text": {
          "color": "rgba(255,255,255,0.72)"
        }
      },
      "communityTemplateCard": {
        "fill": "rgba(255,255,255,0.10)",
        "opacityAffects": false,
        "border": {
          "width": 1.0,
          "style": "solid",
          "color": "rgba(255,255,255,0.22)"
        }
      },
      "dialog.danger.title": {
        "text": {
          "color": "#ffb3c0"
        }
      }
    },
    "images": {},
    "version": "1.0.1",
    "author": "Echosight",
    "description": "Modern glassmorphism theme with blur effects",
    "supportsTransparency": true
  },
