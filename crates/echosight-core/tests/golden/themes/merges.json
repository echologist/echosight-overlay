  {
    "name": "arrays concatenate override then default, null falls back",
    "input": {
      "base": {
        "id": "base",
        "name": "Base",
        "effects": {
          "list": [
            1,
            2
          ],
          "nested": {
            "keep": true,
            "nullBase": null
          },
          "zero": 8,
          "blank": "x"
        },
        "customCSS": "base CSS",
        "sounds": {
          "volume": 0.8,
          "events": {
            "undo": "old.wav"
          }
        }
      },
      "variantId": "ember",
      "config": {
        "effects": {
          "list": [
            3
          ],
          "nested": {
            "keep": null,
            "nullBase": null
          },
          "zero": 0,
          "blank": ""
        },
        "customCSS": ".override {}",
        "sounds": {
          "volume": null,
          "events": {
            "undo": {
              "file": "new.wav"
            }
          }
        }
      }
    },
    "expected": {
      "id": "base-ember",
      "name": "Base (ember)",
      "effects": {
        "list": [
